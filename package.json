{
  "name": "@firecrawl/dsh-firecrawl",
  "description": "Firecrawl-backed search and fetch providers for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.1.0",
  "author": "Firecrawl <support@firecrawl.dev>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./fetch": {
      "types": "./lib/fetch.d.ts",
      "default": "./lib/fetch.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": "github:firecrawl/dsh-firecrawl",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "firecrawl",
    "web-search",
    "web-fetch",
    "scraping"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:manifest && pnpm run check:package",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepare": "pnpm run build",
    "test": "vitest run --exclude 'tests/*.e2e.ts'",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2",
    "@types/node": "26.6.5",
    "js-yaml": "5.5.0",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
